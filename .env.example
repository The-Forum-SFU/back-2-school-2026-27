# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
#
# Everything without a VITE_ prefix is SERVER-ONLY and is never bundled into client
# JS. Vite only exposes VITE_-prefixed vars to the browser, and vite.config.ts throws
# at build time if a secret-looking name ever picks up that prefix.
#
# These must ALSO be set in the Vercel dashboard (Project → Settings → Environment
# Variables). Vercel does not read this file. Missing Supabase vars = 500 on every submit.

# --- Supabase (server-only) -------------------------------------------------
# Service role key bypasses RLS. Never expose it to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing IP addresses before storage (rate limiting without storing raw IPs).
# Any long random string; changing it resets the rate-limit window for everyone.
IP_HASH_SALT=

# --- Meta / Facebook --------------------------------------------------------
# System user token from Business Manager, scoped with Manage Pixel on this dataset.
META_ACCESS_TOKEN=
# For Lead events the CAPI "dataset id" is the same number as the pixel id.
# Both vars below hold that SAME value — one for the server, one for the browser.
# While either is unset, CAPI and the client pixel both no-op cleanly.
META_PIXEL_ID=
VITE_META_PIXEL_ID=

# --- Brevo ------------------------------------------------------------------
# Before this endpoint is used, OPT_IN (boolean) and BIRTH_DATE (date) must exist as
# custom contact attributes in Brevo (Contacts → Settings → Contact Attributes).
# Brevo silently DROPS unknown attributes — no error, the data just never saves.
BREVO_API_KEY=
# The unlisted guestlist route (/list-...). Capped, discounted door entry.
BREVO_LIST_ID_PRESALE=
# The PUBLIC landing page's list, collected before the ticket drop. Uncapped.
#
# NOTE: the marketing opt-in on the form is OPTIONAL, and every signup reaches this list
# either way, carrying its answer in the OPT_IN attribute. So this list is not a lawful
# send list on its own: anything promotional must go to a segment filtered on
# OPT_IN = true. See the note above `attributesFor` in api/_lib/brevo.ts.
BREVO_LIST_ID_MAILING=

# Deferred lists — uncomment as those pages come online.
# Note: the existing .env has BREVO_LIST_ID_VIP / _FRIENDS, which are leftovers from a
# superseded three-list plan and do not map cleanly onto the five ticket types.
# BREVO_LIST_ID_EARLY_ACCESS=
# BREVO_LIST_ID_GENERAL=
# BREVO_LIST_ID_TABLE=
